#!/usr/bin/env bash
set -Eeuo pipefail

if [[ $# -ne 2 ]]; then
  printf 'Usage: %s <vault-checkout-path> <vault-ref>\n' "$0" >&2
  exit 1
fi

if [[ ! -d "$1/.git" || -z "$2" ]]; then
  printf 'A Vault Git checkout and ref are required.\n' >&2
  exit 1
fi

exec python3 "$(dirname -- "$0")/read_vault_config.py" "$@"
