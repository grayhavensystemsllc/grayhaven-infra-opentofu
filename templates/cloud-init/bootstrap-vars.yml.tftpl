#cloud-config

write_files:
  - path: /etc/grayhaven/bootstrap/bootstrap-vars.yml
    owner: root:root
    permissions: '0600'
    content: |
      ${indent(6, bootstrap_vars_yaml)}
  - path: /etc/grayhaven/bootstrap/config.json
    owner: root:root
    permissions: '0600'
    content: |
      ${indent(6, bootstrap_config_json)}
  - path: /etc/grayhaven/bootstrap/bootstrap.py
    owner: root:root
    permissions: '0700'
    content: |
      ${indent(6, bootstrap_script)}

runcmd:
  - [python3, /etc/grayhaven/bootstrap/bootstrap.py]
